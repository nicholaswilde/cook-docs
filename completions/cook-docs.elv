            cand --assets-dir 'optional directory to copy companion recipe images into (slug-named)'
            cand --image-ext 'optional image extension override for Info.ImageSlug (e.g. webp)'
            cand --image-ext-map 'comma-separated source=target image extension mappings for Info.ImageSlug (e.g. jpg=webp,jpeg=webp)'
            cand --convert-images 'convert matching companion images when copying to --assets-dir (supports ''webp'' via cwebp)'
            cand --image-quality 'output image quality (1-100) for --convert-images (default 80)'
            cand --emoji-file 'optional YAML/TOML/JSON file mapping ingredients and cookware to emojis'
            cand --weights-file 'optional YAML/TOML/JSON ingredient density file for toGrams volume-to-weight conversion'
            cand --link-dirs 'comma-separated recipe subdirectories eligible for linkRecipe cross-linking'
            cand --required-metadata 'comma-separated metadata keys required by doctor --check-recipes (e.g. source,serves)'
            cand --ignored-ingredients-file 'optional YAML/TOML/JSON list of ingredients that should not be tagged with ''@'' (checked by doctor --check-recipes)'
            cand --nav-file 'optional Zensical (zensical.toml) or MkDocs (mkdocs.yml) nav file to sync rendered recipes into'
            cand -d 'don''t actually render any markdown files just print to stdout passed'
            cand --dry-run 'don''t actually render any markdown files just print to stdout passed'
            cand -j 'parse the recipe and display it in json format'
            cand --jsonify 'parse the recipe and display it in json format'
            cand --link-in-steps 'cross-link matching @ingredient references inside step directions'
            cand --merge 'merge generated content into existing Markdown files without clobbering manual edits'
            cand --force 'force full overwrite of existing Markdown files even when --merge / merge is enabled'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'cook-docs;completions'= {
            cand -C 'path to configuration file (TOML, YAML, or JSON)'
            cand --config 'path to configuration file (TOML, YAML, or JSON)'
            cand -i 'filename to use as an ignore file to exclude recipe directories (default ".cookdocsignore")'
            cand --ignore-file 'filename to use as an ignore file to exclude recipe directories (default ".cookdocsignore")'
            cand -c 'directory to search recursively within for recipes (default ".")'
            cand --recipe-search-root 'directory to search recursively within for recipes (default ".")'
            cand -l 'level of logs that should printed, one of (panic, fatal, error, warning, info, debug, trace) (default "info")'
            cand --log-level 'level of logs that should printed, one of (panic, fatal, error, warning, info, debug, trace) (default "info")'
            cand -t 'gotemplate file paths relative to each recipe directory from which documentation will be generated (default "recipe.md.gotmpl")'
            cand --template-files 'gotemplate file paths relative to each recipe directory from which documentation will be generated (default "recipe.md.gotmpl")'
            cand -w 'word wrap line length for recipe steps section (default 120)'
            cand --word-wrap 'word wrap line length for recipe steps section (default 120)'
            cand -o 'custom output directory to write generated markdown documentation'
            cand --output-dir 'custom output directory to write generated markdown documentation'
            cand --assets-dir 'optional directory to copy companion recipe images into (slug-named)'
            cand --image-ext 'optional image extension override for Info.ImageSlug (e.g. webp)'
            cand --image-ext-map 'comma-separated source=target image extension mappings for Info.ImageSlug (e.g. jpg=webp,jpeg=webp)'
            cand --convert-images 'convert matching companion images when copying to --assets-dir (supports ''webp'' via cwebp)'
            cand --image-quality 'output image quality (1-100) for --convert-images (default 80)'
            cand --emoji-file 'optional YAML/TOML/JSON file mapping ingredients and cookware to emojis'
            cand --weights-file 'optional YAML/TOML/JSON ingredient density file for toGrams volume-to-weight conversion'
            cand --link-dirs 'comma-separated recipe subdirectories eligible for linkRecipe cross-linking'
            cand --required-metadata 'comma-separated metadata keys required by doctor --check-recipes (e.g. source,serves)'
            cand --ignored-ingredients-file 'optional YAML/TOML/JSON list of ingredients that should not be tagged with ''@'' (checked by doctor --check-recipes)'
            cand --nav-file 'optional Zensical (zensical.toml) or MkDocs (mkdocs.yml) nav file to sync rendered recipes into'
            cand -d 'don''t actually render any markdown files just print to stdout passed'
            cand --dry-run 'don''t actually render any markdown files just print to stdout passed'
            cand -j 'parse the recipe and display it in json format'
            cand --jsonify 'parse the recipe and display it in json format'
            cand --link-in-steps 'cross-link matching @ingredient references inside step directions'
            cand --merge 'merge generated content into existing Markdown files without clobbering manual edits'
            cand --force 'force full overwrite of existing Markdown files even when --merge / merge is enabled'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'cook-docs;man'= {
            cand -C 'path to configuration file (TOML, YAML, or JSON)'
            cand --config 'path to configuration file (TOML, YAML, or JSON)'
            cand -i 'filename to use as an ignore file to exclude recipe directories (default ".cookdocsignore")'
            cand --ignore-file 'filename to use as an ignore file to exclude recipe directories (default ".cookdocsignore")'
            cand -c 'directory to search recursively within for recipes (default ".")'
            cand --recipe-search-root 'directory to search recursively within for recipes (default ".")'
            cand -l 'level of logs that should printed, one of (panic, fatal, error, warning, info, debug, trace) (default "info")'
            cand --log-level 'level of logs that should printed, one of (panic, fatal, error, warning, info, debug, trace) (default "info")'
            cand -t 'gotemplate file paths relative to each recipe directory from which documentation will be generated (default "recipe.md.gotmpl")'
            cand --template-files 'gotemplate file paths relative to each recipe directory from which documentation will be generated (default "recipe.md.gotmpl")'
            cand -w 'word wrap line length for recipe steps section (default 120)'
            cand --word-wrap 'word wrap line length for recipe steps section (default 120)'
            cand -o 'custom output directory to write generated markdown documentation'
            cand --output-dir 'custom output directory to write generated markdown documentation'
            cand --assets-dir 'optional directory to copy companion recipe images into (slug-named)'
            cand --image-ext 'optional image extension override for Info.ImageSlug (e.g. webp)'
            cand --image-ext-map 'comma-separated source=target image extension mappings for Info.ImageSlug (e.g. jpg=webp,jpeg=webp)'
            cand --convert-images 'convert matching companion images when copying to --assets-dir (supports ''webp'' via cwebp)'
            cand --image-quality 'output image quality (1-100) for --convert-images (default 80)'
            cand --emoji-file 'optional YAML/TOML/JSON file mapping ingredients and cookware to emojis'
            cand --weights-file 'optional YAML/TOML/JSON ingredient density file for toGrams volume-to-weight conversion'
            cand --link-dirs 'comma-separated recipe subdirectories eligible for linkRecipe cross-linking'
            cand --required-metadata 'comma-separated metadata keys required by doctor --check-recipes (e.g. source,serves)'
            cand --ignored-ingredients-file 'optional YAML/TOML/JSON list of ingredients that should not be tagged with ''@'' (checked by doctor --check-recipes)'
            cand --nav-file 'optional Zensical (zensical.toml) or MkDocs (mkdocs.yml) nav file to sync rendered recipes into'
            cand -d 'don''t actually render any markdown files just print to stdout passed'
            cand --dry-run 'don''t actually render any markdown files just print to stdout passed'
            cand -j 'parse the recipe and display it in json format'
            cand --jsonify 'parse the recipe and display it in json format'
            cand --link-in-steps 'cross-link matching @ingredient references inside step directions'
            cand --merge 'merge generated content into existing Markdown files without clobbering manual edits'
            cand --force 'force full overwrite of existing Markdown files even when --merge / merge is enabled'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'cook-docs;doctor'= {
            cand --only 'Comma-separated recipe check categories to run (syntax,images,metadata,emojis,ignored)'
            cand -C 'path to configuration file (TOML, YAML, or JSON)'
            cand --config 'path to configuration file (TOML, YAML, or JSON)'
            cand -i 'filename to use as an ignore file to exclude recipe directories (default ".cookdocsignore")'
            cand --ignore-file 'filename to use as an ignore file to exclude recipe directories (default ".cookdocsignore")'
            cand -c 'directory to search recursively within for recipes (default ".")'
            cand --recipe-search-root 'directory to search recursively within for recipes (default ".")'
            cand -l 'level of logs that should printed, one of (panic, fatal, error, warning, info, debug, trace) (default "info")'
            cand --log-level 'level of logs that should printed, one of (panic, fatal, error, warning, info, debug, trace) (default "info")'
            cand -t 'gotemplate file paths relative to each recipe directory from which documentation will be generated (default "recipe.md.gotmpl")'
            cand --template-files 'gotemplate file paths relative to each recipe directory from which documentation will be generated (default "recipe.md.gotmpl")'
            cand -w 'word wrap line length for recipe steps section (default 120)'
            cand --word-wrap 'word wrap line length for recipe steps section (default 120)'
            cand -o 'custom output directory to write generated markdown documentation'
            cand --output-dir 'custom output directory to write generated markdown documentation'
            cand --assets-dir 'optional directory to copy companion recipe images into (slug-named)'
            cand --image-ext 'optional image extension override for Info.ImageSlug (e.g. webp)'
            cand --image-ext-map 'comma-separated source=target image extension mappings for Info.ImageSlug (e.g. jpg=webp,jpeg=webp)'
            cand --convert-images 'convert matching companion images when copying to --assets-dir (supports ''webp'' via cwebp)'
            cand --image-quality 'output image quality (1-100) for --convert-images (default 80)'
            cand --emoji-file 'optional YAML/TOML/JSON file mapping ingredients and cookware to emojis'
            cand --weights-file 'optional YAML/TOML/JSON ingredient density file for toGrams volume-to-weight conversion'
            cand --link-dirs 'comma-separated recipe subdirectories eligible for linkRecipe cross-linking'
